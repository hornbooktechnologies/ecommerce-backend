# Copy this setting into the BACKEND .env only after SMTP and storefront URLs are configured.
# Restart the API after changing it. The separately launched worker uses the same .env.
ORDER_EMAILS_ENABLED=false
# Reuses SMTP_HOST/PORT/SECURE/USER/PASS (or SMTP_PASSWORD)/FROM and CUSTOMER_STOREFRONT_URLS.
# See customer-account.env.example; use a Google app password, never commit credentials.
# No email is sent by the API itself. Run a separate process after enabling:
#   npm run notifications:work
# Process at most one due job (DOES SEND mail if enabled):
#   npm run notifications:once
# Safe read-only queue counts (does not send):
#   npm run notifications:status
# Only NEW events are queued while enabled; old outbox events are not replayed.
# Recipients must already have a verified, active customer account at event time.
# Order received/cancelled, shipment dispatched/delivered, and return/exchange updates.
# 5 attempts, exponential backoff; abandoned claims recover after 2 minutes.
# SUCCEEDED means accepted by SMTP, not guaranteed inbox delivery.
# SMTP is at-least-once: a crash after acceptance can cause a duplicate on retry.
# FAILED jobs remain available in background_jobs for investigation; no automatic endless retries.
# No migrations, Redis, Docker, or payment/refund automation is needed.
